# tar --exclude-from patterns used by bin/deploy.sh when copying
#   /home/smartqaq/repositories/nfelia/  ->  /home/smartqaq/public_html/nfelia.com/
#
# FORMAT: read by GNU tar, not rsync. Two rules decide everything here:
#
#   1. tar compares each pattern against the archive member name, which is
#      "./path/to/file" because deploy.sh archives with `-C "$REPO" .`.
#      A ROOT-ONLY entry is therefore written "./name".
#   2. tar SILENTLY IGNORES any pattern starting or ending with "/".
#      "docs/" and "/DEPLOY.md" match NOTHING. This fails open — the file
#      lands on the public web with no error anywhere — which is why the
#      CI workflow asserts these exclusions actually hold.
#
# A BARE name with no slash matches at ANY depth. Use that only when the
# file should be skipped wherever it appears (".env", "error_log").
#
# tar never deletes. Anything excluded here is simply not copied, which is
# how runtime files (.env, .htaccess, uploads/, storage/) survive deploys —
# the docroot copy stays authoritative.

# Git internals and CI config — never belong in a public docroot
./.git
./.github
./.gitignore
./.cpanel.yml
./.deployignore

# Secrets. Bare, so a stray .env at any depth is skipped too.
.env
.env.local
.env.*.local

# cPanel-generated PHP config at the root (docroot copy authoritative)
./.user.ini
./php.ini

# Runtime data (docroot copy authoritative)
./uploads
./storage/momo_receipts
./storage/logs

# PHP error logs, any depth
error_log

# Composer artefacts — regenerated by composer install in the deploy step
./vendor
./composer.phar

# Repo-only material. docs/ holds internal audit and brand notes that must
# never be served. bin/ and db/ are operational, not public.
./docs
./bin
./db
./DEPLOY.md
./README.md
./.ux-profile.md

# Database dumps must never reach the web root
*.sql
*.sql.gz

# IDE / OS junk, any depth
.vscode
.idea
.DS_Store
Thumbs.db
