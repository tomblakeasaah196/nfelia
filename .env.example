# =============================================================
# NFELIA — Environment Configuration Template
# =============================================================
# Copy to .env and fill in real values. .env is git-ignored AND
# deploy-ignored: the copy living in the docroot is the only
# authoritative one, and no deploy ever overwrites it.
# =============================================================

# ── Application ───────────────────────────────────────────────
APP_NAME=Nfelia
APP_ENV=production
APP_DEBUG=false
APP_URL=https://nfelia.com

# REQUIRED. Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=REPLACE_WITH_64_CHAR_HEX_STRING

# Optional. The secret document signatures are sealed with. Leave it unset:
# Nfelia makes one the first time and keeps it in storage/private/seal.key.
# Set it only to share one key between servers; changing it later means no
# earlier signature checks out at nfelia.com/verify.
# SEAL_KEY=

# Optional. Seconds without use before Nfelia locks and asks for the
# fingerprint, face or password again. Default 7200 (2 hours). APP_URL is
# also where passkeys live: they only work on that exact address.
# LOCK_AFTER_SECONDS=7200

# Optional. New passwords are checked against known data breaches through
# Have I Been Pwned (only the first five characters of a hash ever leave the
# server). Set to off on a test copy with no internet, or if the service is
# ever a problem; the length and character rules still apply.
# PASSWORD_BREACH_CHECK=on

# ── Database ──────────────────────────────────────────────────
# Use localhost, never the server's public IP: a shared-hosting IP
# can change (it did during the 2026 migration) and localhost uses
# the local socket, which is faster and cannot be firewalled off.
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# ── SMTP Mail ─────────────────────────────────────────────────
# cPanel's own SMTP. 465 = SSL (SMTPS), 587 = TLS (STARTTLS).
# Do NOT wrap values in quotes. config/env.php strips one layer of
# surrounding quotes, but an older copy did not, and a quoted
# password authenticated with the quote characters included.
MAIL_HOST=localhost
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=no-reply@nfelia.com
MAIL_PASSWORD=your_mailbox_password
MAIL_FROM_ADDRESS=no-reply@nfelia.com
MAIL_FROM_NAME=Nfelia

# ── Paystack ──────────────────────────────────────────────────
# Webhook URL to register in the Paystack dashboard:
#   https://nfelia.com/api/webhooks
# Callback URL (dashboard fallback; the app passes its own per
# transaction, built from APP_URL):
#   https://nfelia.com/billing/callback
# Webhooks are checked with the secret key itself (Paystack signs with it),
# so there is no separate webhook secret to set.
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
# Plans are no longer used for new payments: each payment buys one month
# (app/helpers/billing.php). These stay for card subscriptions made before.
PAYSTACK_PLAN_CODE=PLN_xxxxxxxxxx
PAYSTACK_SEAT_PLAN_CODE=PLN_xxxxxxxxxx
# Local tests only: point the app at docs/handoff/testkit/paystack_mock.php.
# Leave unset in production.
# PAYSTACK_API_BASE=http://127.0.0.1:8096
# Local tests only: stand-in phones (docs/handoff/testkit/push_endpoint.php)
# that web push may call. Leave unset in production.
# PUSH_TEST_ENDPOINTS=http://127.0.0.1:8098/,http://127.0.0.1:8097/

# ── Uploads ───────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10

# Absolute path, OUTSIDE the docroot, writable by the web user.
MOMO_RECEIPT_DIR=/home/smartqaq/momo_receipts

# ── Deploy webhook ────────────────────────────────────────────
# GitHub Actions POSTs to https://nfelia.com/webhook/deploy.php with
# header X-Deploy-Token matching this value. Minimum 32 characters;
# anything shorter is refused by the endpoint. Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
# The same value becomes the repo's Actions secret DEPLOY_WEBHOOK_SECRET.
DEPLOY_WEBHOOK_SECRET=

# ── Phone notifications (web push) ────────────────────────────
# Optional. Without these, reminders still arrive by bell and email.
# Generate once, on the server, from the repository copy:
#   php ~/repositories/nfelia/bin/vapid-keys.php
# and paste the three lines it prints here. Never change the pair once
# people have turned notifications on: their phones are tied to it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@nfelia.com

# ── Cloudflare cache purge (shops) ────────────────────────────
# Optional. Shop pages are cached at Cloudflare for up to five minutes;
# with these two set, publishing in Shop Studio or editing a product
# clears that shop's copy at once. Without them shops still catch up
# within five minutes.
# Create the token at dash.cloudflare.com → My Profile → API Tokens →
# Create Token → Custom token, with ONE permission: Zone → Cache Purge →
# Purge, limited to the nfelia.com zone. Nothing else.
# The zone ID is on the nfelia.com Overview page (right-hand column).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ── Maps (the shop's "Map and directions") ────────────────────
# Optional. Geoapify (geoapify.com; the free plan has 3,000 credits a day)
# finds an owner's address in Shop Studio and draws the map picture at the
# bottom of their shop, once per pin; the picture is then kept and served
# by Nfelia, so shoppers never call Geoapify. Without a key, owners place the pin by pasting a Google Maps
# link, and the shop shows the address and Get directions without a map.
# Create one project at myprojects.geoapify.com with two keys:
#   GEOAPIFY_API_KEY      used by the server only. Leave it unrestricted, or
#                         restrict it to this server's IP address.
#   GEOAPIFY_BROWSER_KEY  shown in Shop Studio for the draggable map. In the
#                         key's settings, allow only https://nfelia.com and
#                         https://*.nfelia.com. Defaults to the key above.
GEOAPIFY_API_KEY=
GEOAPIFY_BROWSER_KEY=
# Local tests only: point both at docs/handoff/testkit/geoapify_mock.php
# (GEOAPIFY_API_KEY=test-key). Leave unset in production.
# GEOAPIFY_API_URL=http://127.0.0.1:8099
# GEOAPIFY_MAPS_URL=http://127.0.0.1:8099

# ── Backups ───────────────────────────────────────────────────
# Optional. Where bin/backup.sh keeps its dated folders and backup.log, and
# where Ops → Health looks to see that last night's backup ran. Default:
# ~/backups/nfelia (two folders above the docroot). Never under public_html.
# BACKUP_DIR=/home/smartqaq/backups/nfelia

# Origin lock (docs/ops/SECURITY.md §5, RUNBOOK §4.4). Cloudflare adds the
# request header X-Nfelia-Edge with this value to everything it forwards (a
# Transform Rule); bin/deploy.sh writes the same value into .htaccess, which
# then refuses any request without it. Letters, digits, - and _, 24 to 128
# characters (openssl rand -hex 24). Leave it unset and the lock stays off.
# Create the Cloudflare rule BEFORE setting this, or every page answers 403.
# EDGE_TOKEN=

# ── The Records Book ──────────────────────────────────────────
# Optional. The most cells one Records Book holds (app/helpers/records.php);
# past it the owner is asked to choose a shorter period. Making a book takes
# about 700 bytes of memory a cell (600000 is about 420 MB); the build asks
# PHP for 1 GB where the host allows it. Lower this if the host's own limit
# (cPanel → Resource Usage) is smaller.
RECORDS_MAX_CELLS=600000
