# =============================================================
# NFELIA — Environment Configuration Template
# =============================================================
# Copy to .env and fill in real values. .env is git-ignored AND
# deploy-ignored: the copy living in the docroot is the only
# authoritative one, and no deploy ever overwrites it.
# =============================================================

# ── Application ───────────────────────────────────────────────
APP_NAME=Nfelia
APP_ENV=production
APP_DEBUG=false
APP_URL=https://nfelia.com

# REQUIRED. Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=REPLACE_WITH_64_CHAR_HEX_STRING

# ── Database ──────────────────────────────────────────────────
# Use localhost, never the server's public IP: a shared-hosting IP
# can change (it did during the 2026 migration) and localhost uses
# the local socket, which is faster and cannot be firewalled off.
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# ── SMTP Mail ─────────────────────────────────────────────────
# cPanel's own SMTP. 465 = SSL (SMTPS), 587 = TLS (STARTTLS).
# Do NOT wrap values in quotes. config/env.php strips one layer of
# surrounding quotes, but an older copy did not, and a quoted
# password authenticated with the quote characters included.
MAIL_HOST=localhost
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=no-reply@nfelia.com
MAIL_PASSWORD=your_mailbox_password
MAIL_FROM_ADDRESS=no-reply@nfelia.com
MAIL_FROM_NAME=Nfelia

# ── Paystack ──────────────────────────────────────────────────
# Webhook URL to register in the Paystack dashboard:
#   https://nfelia.com/api/webhooks
# Callback URL (dashboard fallback; the app passes its own per
# transaction, built from APP_URL):
#   https://nfelia.com/billing/callback
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=sk_live_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PLAN_CODE=PLN_xxxxxxxxxx
PAYSTACK_SEAT_PLAN_CODE=PLN_xxxxxxxxxx

# ── Uploads ───────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10

# Absolute path, OUTSIDE the docroot, writable by the web user.
MOMO_RECEIPT_DIR=/home/smartqaq/momo_receipts

# ── Deploy webhook ────────────────────────────────────────────
# GitHub Actions POSTs to https://nfelia.com/webhook/deploy.php with
# header X-Deploy-Token matching this value. Minimum 32 characters;
# anything shorter is refused by the endpoint. Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
# The same value becomes the repo's Actions secret DEPLOY_WEBHOOK_SECRET.
DEPLOY_WEBHOOK_SECRET=
