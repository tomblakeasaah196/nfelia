Options -Indexes
ServerSignature Off
DirectoryIndex index.php

# --- Only Cloudflare may talk to this site (docs/ops/SECURITY.md §5) ---
# Every nfelia.com name is proxied, so a request from any other address has
# skipped Cloudflare and its rules: it is refused. The ranges are Cloudflare's
# published list, https://www.cloudflare.com/ips/ ; bin/env-report.sh
# (section 6) compares the two, and the runbook says to look once a month: a
# range added there and missing here means a 403 for the visitors behind it.
# .well-known/ stays open to everyone (.well-known/.htaccess): certificate
# checks for the mail names arrive there directly. Several Require lines in
# one section mean "any of these".
Require ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18
Require ip 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17
Require ip 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
Require ip 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

# --- Custom Error Pages ---
ErrorDocument 404 /views/404.php
ErrorDocument 500 /views/500.php

# --- Block direct access to sensitive folders ---
RewriteEngine On

# --- Redirect old domain (nfelia.lpc.cm) to new domain (nfelia.com) ---
RewriteCond %{HTTP_HOST} ^(www\.)?nfelia\.lpc\.cm$ [NC]
RewriteRule ^(.*)$ https://nfelia.com/$1 [R=301,L]
   
# Allow standalone error pages to bypass the views block below
RewriteRule ^views/(404|500)\.php$ - [L]

RewriteRule ^config/ - [F,L]
RewriteRule ^app/ - [F,L]
RewriteRule ^views/ - [F,L]
RewriteRule ^storage/ - [F,L]
# Libraries are loaded by the app, never opened by a browser: no file under
# vendor/ or lib/ should run or be read on its own.
RewriteRule ^(vendor|lib)/ - [F,L]

# Customers' signatures and payment screenshots saved before they moved to
# storage/private/. They are sent only by the pages that check who is asking
# (send_private_file in app/helpers/functions.php).
RewriteRule ^uploads/(delivery_signoffs|order_proofs|booking_proofs)/ - [F,L]
# Nothing under uploads/ ever runs as a script
RewriteRule ^uploads/.*\.(php[0-9]?|phtml|phar|pl|py|cgi|shtml)$ - [F,L,NC]

# --- Block file types that must never be served, whatever their name ---
# A 2026-07 database dump sat at the docroot root and was publicly
# downloadable for three months, because the front-controller rule below
# only rewrites paths that are NOT real files. Anything that exists on
# disk is served raw. This is the backstop for that.
<FilesMatch "\.(sql|gz|tar|zip|dump|bak|log|md|ini|lock|phar|sh|yml|yaml|example)$">
    Require all denied
</FilesMatch>

# cPanel's PHP writes a bare "error_log" file next to the script that
# failed. It has no extension, so the rule above never matched it, and it
# holds file paths and whatever the error message carried.
<Files "error_log">
    Require all denied
</Files>
# The dependency list is for Composer, not visitors
<Files "composer.json">
    Require all denied
</Files>

# --- Block access to .env and hidden files ---
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# --- Front Controller: Route everything to index.php ---
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]

# --- Security Headers ---
# HSTS is set at Cloudflare (Edge Certificates), where every nfelia.com
# host is served; see docs/ops/SECURITY.md before changing either place.
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    # The old XSS auditor is gone from every browser; "0" is the safe value
    # (the auditor itself could be abused where it still ran).
    Header always set X-XSS-Protection "0"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # No page of Nfelia may be framed by another site, rebased, or embed
    # plugins. Script and style sources are governed separately, page by
    # page, once the report-only trial has run (docs/ops/SECURITY.md).
    Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
    # The full policy, on trial: nothing is blocked, browsers tell /api/csp
    # what would have been, and Ops → Errors lists it as "Content policy".
    # After two clean weeks the same line moves to Content-Security-Policy,
    # minus 'unsafe-inline' once the inline scripts carry nonces and minus
    # 'unsafe-eval' once Alpine's CSP build is in (docs/ops/SECURITY.md §6).
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://nfelia.com https://fonts.gstatic.com; img-src 'self' data: blob: https://nfelia.com https://*.nfelia.com https://i.ytimg.com; media-src 'self' blob:; connect-src 'self'; frame-src 'self' https://www.youtube-nocookie.com; worker-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; report-uri /api/csp"
    # Nothing in Nfelia uses these browser features; saying so stops any
    # script that slips in from asking for them.
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()"
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

    # --- Caching ---
    # Styles, scripts, fonts and images under assets/, icons/ and uploads/
    # carry their own .htaccess (a year; their names change when they do).
    # Files at the root (icons, the manifest, the offline page) change in
    # place now and then: a day.
    <FilesMatch "\.(png|ico|svg|webmanifest|html)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
    # The service workers must be checked on every start, or a new version
    # of the app waits a day behind the old one.
    <FilesMatch "^(sw|ops-sw)\.js$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# --- PHP Settings for shared hosting ---
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 60
    php_value memory_limit 128M
    php_flag display_errors Off
    php_flag log_errors On
    php_value error_log /home/smartqaq/public_html/nfelia.com/storage/logs/php_errors.log
</IfModule>

# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_flag display_errors Off
   php_value max_execution_time 120
   php_value max_input_time 60
   php_value max_input_vars 1000
   php_value memory_limit 512M
   php_value post_max_size 64M
   php_value session.gc_maxlifetime 7200
   php_value session.save_path "/var/cpanel/php/sessions/ea-php83"
   php_value upload_max_filesize 32M
   php_flag zlib.output_compression Off
</IfModule>
<IfModule lsapi_module>
   php_flag display_errors Off
   php_value max_execution_time 120
   php_value max_input_time 60
   php_value max_input_vars 1000
   php_value memory_limit 512M
   php_value post_max_size 64M
   php_value session.gc_maxlifetime 7200
   php_value session.save_path "/var/cpanel/php/sessions/ea-php83"
   php_value upload_max_filesize 32M
   php_flag zlib.output_compression Off
</IfModule>
# END cPanel-generated php ini directives, do not edit

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
